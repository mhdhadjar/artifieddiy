# Copy to .env before starting Compose.
# Dev values below work on macOS. Prod notes are at the bottom.

MONGODB_URI=mongodb://mongo:27017/artifieddiy
JWT_SECRET=dev-only-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:2201/auth/google/callback
ADMIN_EMAILS=artifieddiy@gmail.com, mhdhadjar@gmail.com
YOUTUBE_API_KEY=
COOKIE_DOMAIN=localhost
WEB_ORIGIN=http://localhost:2202
ADMIN_ORIGIN=http://localhost:2203
API_PUBLIC_URL=http://localhost:2201
CORS_ORIGINS=http://localhost:2202,http://localhost:2203
# Project file uploads. Docker sets this to /data/uploads.
# UPLOAD_DIR=./uploads

# Ubuntu production:
# COOKIE_DOMAIN=.artifieddiy.com
# WEB_ORIGIN=https://artifieddiy.com
# ADMIN_ORIGIN=https://admin.artifieddiy.com
# API_PUBLIC_URL=https://api.artifieddiy.com
# GOOGLE_CALLBACK_URL=https://api.artifieddiy.com/auth/google/callback
# CORS_ORIGINS=https://artifieddiy.com,https://www.artifieddiy.com,https://admin.artifieddiy.com
